# The Gremlin

# Copy this to .env and fill in the real values. Never commit .env.

# --- Slack (required) ---
# Create the app at https://api.slack.com/apps, see README.md.
# xoxb-... token from OAuth & Permissions after installing the app.
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
# xapp-... token from Basic Information > App-Level Tokens (needs connections:write).
SLACK_APP_TOKEN=xapp-your-app-level-token-here
# The bot's own Slack user ID, e.g. U0XXXXXXXXX. Find it in the app's
# OAuth page, or run the bot once and read it from the startup log.
# If left blank, mention detection still works in the home channel.
GREMLIN_BOT_USER_ID=

# --- Channel (required) ---
# Sami's random channel. Only messages in this channel get replies.
GREMLIN_CHANNEL_ID=C0CLXF7ECRF

# --- LLM (optional, but recommended) ---
# Without a key the bot still works, it just uses canned gremlin replies.
# With a key it replies with an LLM, like the Warden does.
# Any OpenAI-compatible API works. Examples:
#   OpenRouter: https://openrouter.ai/api/v1  (FREE models only, all end in :free)
#   OpenAI:     https://api.openai.com/v1      (model e.g. gpt-4o-mini)
#   Hack Club AI: set LLM_BASE_URL to your Hack Club AI endpoint if you have access.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemma-4-26b-a4b-it:free
# Free models only. Fallbacks tried in order if the first is rate-limited.
LLM_FALLBACK_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,liquid/lfm-3-1.7b:free,baidu/ernie-5.5-flash-preview:free

# --- Behaviour (optional) ---
# Reply to every message in the home channel (true), or only when
# someone says "gremlin" or @mentions the bot (false).
GREMLIN_REPLY_TO_ALL=true
# Random unprompted gremlin drops in the channel, max per day. 0 = off.
GREMLIN_RANDOM_PER_DAY=3
# How many messages of thread history to send to the LLM.
GREMLIN_THREAD_MEMORY=20
GROQ_API_KEY=
